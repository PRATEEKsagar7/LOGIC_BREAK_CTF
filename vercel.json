{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index.js?__route=/api/:path*"
    },
    {
      "source": "/challenge_files/:path*",
      "destination": "/challenge_files/:path*"
    }
  ]
}
